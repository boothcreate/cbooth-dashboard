# Copy to ".env" (no .example) and fill in.
#
# A calendar feed URL is a BEARER CREDENTIAL. Anyone holding the Brightspace
# one can read your entire schedule without logging in as you. Never paste it
# into a chat, an issue, or a commit.
#
# Any variable ending in _ICS becomes a feed automatically. Adding a calendar
# later means adding one line here — no code changes.

BRIGHTSPACE_ICS=
OUTLOOK_ICS=
UVM_ACADEMIC_ICS=
LAB_ICS=
PERSONAL_ICS=

# Google Calendar reminders (see config.yaml's `reminders` section and
# BUILD.md, "Google Calendar reminders"). CLIENT_ID/CLIENT_SECRET come from
# a Desktop-app OAuth client you create once in Google Cloud Console.
# REFRESH_TOKEN comes from running scripts/google_calendar_auth.py once,
# after the two above are set — it prints the value to paste here. Leave
# all three blank to turn Calendar reminders off; the to-do list itself
# works fine either way.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
